---
/**
 * GitHub Star 按钮。
 *
 * GitHub 不允许第三方页面在访客未授权的情况下替他点 star，所以这里是一个
 * 直达仓库页的链接：访客点进去，在右上角再点一下 Star 即可。
 * star 数在浏览器里向 GitHub API 实时取，取不到（限流/断网）时只显示按钮。
 */
interface Props {
  repo?: string;
  label?: string;
  size?: 'sm' | 'md';
}
const { repo = 'Teddy-Yangjiale/notes', label = '在 GitHub 上点个 Star', size = 'md' } = Astro.props;
---

<a
  class:list={['star', size]}
  href={`https://github.com/${repo}`}
  target="_blank"
  rel="noopener"
  data-repo={repo}
  aria-label={`${label}（打开 GitHub 仓库 ${repo}）`}
>
  <svg class="icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
    <path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
  </svg>
  <span class="label">{label}</span>
  <span class="count" hidden></span>
</a>

<script>
  // 同一页面多个按钮共用一次请求；结果缓存 10 分钟，避免撞 GitHub 未认证限流（60 次/小时）
  const TTL = 10 * 60 * 1000;
  const inflight = new Map<string, Promise<number | null>>();

  function fetchStars(repo: string): Promise<number | null> {
    const key = `stars:${repo}`;
    try {
      const hit = JSON.parse(localStorage.getItem(key) ?? 'null');
      if (hit && Date.now() - hit.t < TTL) return Promise.resolve(hit.n);
    } catch {}
    if (!inflight.has(repo)) {
      inflight.set(
        repo,
        fetch(`https://api.github.com/repos/${repo}`)
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            const n = typeof d?.stargazers_count === 'number' ? d.stargazers_count : null;
            if (n !== null) {
              try { localStorage.setItem(key, JSON.stringify({ n, t: Date.now() })); } catch {}
            }
            return n;
          })
          .catch(() => null)
      );
    }
    return inflight.get(repo)!;
  }

  function initStars() {
    document.querySelectorAll<HTMLAnchorElement>('a.star[data-repo]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = '1';
      fetchStars(el.dataset.repo!).then((n) => {
        const badge = el.querySelector<HTMLElement>('.count');
        if (badge && n !== null) {
          badge.textContent = n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
          badge.hidden = false;
        }
      });
    });
  }

  initStars();
  document.addEventListener('astro:after-swap', initStars);
</script>

<style>
  .star {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    font-size: .86rem;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    background: var(--paper-card);
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    box-shadow: var(--lift-1);
    overflow: hidden;
    transition:
      transform .24s cubic-bezier(.2,.9,.3,1.25),
      box-shadow .24s ease,
      border-color .24s ease;
  }
  .star > * { display: inline-flex; align-items: center; }

  .icon {
    box-sizing: content-box;
    padding: .5rem 0 .5rem .7rem;
    color: var(--sw-sand);
    filter: saturate(1.3);
    transition: transform .45s cubic-bezier(.2,.9,.3,1.4), color .2s ease;
  }
  .label { padding: .5rem .75rem .5rem .45rem; font-weight: 500; }
  .count {
    padding: .5rem .7rem;
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--sw-sand) 22%, var(--paper-sunk));
    border-left: 1px solid var(--rule);
  }
  .count[hidden] { display: none; }

  .sm { font-size: .8rem; }
  .sm .icon { padding: .38rem 0 .38rem .55rem; }
  .sm .label { padding: .38rem .6rem .38rem .35rem; }
  .sm .count { padding: .38rem .55rem; }

  @media (hover: hover) {
    .star:hover {
      transform: translateY(-2px) rotate(-.8deg);
      box-shadow: var(--lift-2);
      border-color: color-mix(in srgb, var(--sw-sand) 80%, var(--rule-strong));
    }
    .star:hover .icon { transform: rotate(72deg) scale(1.15); color: #E0A526; }
  }
  @media (prefers-reduced-motion: reduce) {
    .star, .icon { transition: none; }
    .star:hover, .star:hover .icon { transform: none; }
  }
</style>
